## nano config — stowed from dotfiles (needs nano 4.0+, i.e. the Homebrew/apt build)

# ----- Editing -----
set autoindent          # match indentation of the previous line on Enter
set tabsize 4           # render a tab as 4 columns
set tabstospaces        # insert spaces instead of a tab character
set trimblanks          # strip trailing whitespace when soft-wrapping

# ----- Interface -----
set linenumbers         # show line numbers in the left margin
set mouse               # click to move the cursor / select text
set softwrap            # wrap long lines on screen instead of scrolling
set constantshow        # always show the cursor position (line, col)
set titlecolor brightwhite,blue
set numbercolor cyan
set selectedcolor brightwhite,magenta

# ----- Behavior -----
set historylog          # remember search-and-replace history between sessions
set positionlog         # reopen files at the last cursor position
set zap                 # Ctrl-K deletes the selection in one stroke

# ----- Syntax highlighting -----
# No include lines here on purpose: nano errors out ("Mistakes in .nanorc")
# if an include path's directory doesn't exist, and the syntax dir differs
# per platform. Both platforms' global nanorc already loads the bundled
# syntaxes automatically — /opt/homebrew/etc/nanorc on macOS, /etc/nanorc on
# Debian/Ubuntu — so highlighting works without listing them again.
